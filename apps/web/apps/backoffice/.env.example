# Server-only values (never sent to the browser).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service role: the Midtrans webhook marks payments, and the admin functions read them. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the backoffice, used in email links. Localhost for testing; set the production URL at deploy.
APP_URL=http://localhost:3001
# Landing page URL for "Ke beranda" links.
VITE_LANDING_URL=http://localhost:3000
# Midtrans (Snap). Server key from the Midtrans dashboard; sandbox until MIDTRANS_IS_PRODUCTION is true.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
